# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo flash (plano grátis). Troque se o Google renomear.
GEMINI_MODEL=gemini-flash-latest

# Token secreto que o Tasker/MacroDroid manda no header x-token.
# Gere um com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_TOKEN=troque-por-um-token-grande-e-aleatorio

# SEU número com DDI+DDD, só dígitos. Ex.: 5511999998888
MEU_NUMERO=

# self      = converse consigo mesmo ("Mensagens para você") com o seu próprio WhatsApp
# dedicado  = o bot roda num número/chip separado e conversa com MEU_NUMERO
MODO_CHAT=self

PORT=3000
TZ=America/Sao_Paulo

# Opcional
# DB_PATH=./data/dinheiro.db
# LOG_LEVEL=info     (debug | info | warn | erro)
